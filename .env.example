# TERZI ERP — приклад оточення. НЕ комітити реальні значення.
# Скопіюйте у .env і заповніть зі свого Supabase/провайдерів.

# --- Supabase (клієнт, публічні значення) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Supabase (сервер: server functions / API routes) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=<project-ref>
# Секрет. Тільки сервер. Ніколи не в браузер і не в git.
SUPABASE_SERVICE_ROLE_KEY=
# Пряме підключення для міграцій/снапшотів схеми (psql / supabase CLI).
SUPABASE_DB_URL=

# --- Інтеграції (секрети, зберігати в secret store середовища) ---
KEYCRM_API_KEY=
BINOTEL_API_KEY=
BINOTEL_API_SECRET=
BINOTEL_COMPANY_ID=
BINOTEL_WEBHOOK_TOKEN=
LEAD_INTAKE_SECRET=
INTEGRATIONS_WORKER_SECRET=
ERP_PUBLIC_BASE_URL=https://terzi-erp.example

# --- AI / зовнішні сервіси (опційно) ---
LOVABLE_API_KEY=
GOOGLE_CALENDAR_API_KEY=

# --- E2E ---
# Якщо задано, Playwright не піднімає dev-сервер, а б'є у вказаний URL.
E2E_BASE_URL=
